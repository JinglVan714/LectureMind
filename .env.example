# ---- Models: split stack ----
# We run a split model stack to minimise cost while keeping visual
# quality high:
#   * Text + Copilot  -> DeepSeek official API (OpenAI-compatible)
#   * Vision (VLM)    -> DashScope Qwen native multimodal
#   * Embeddings      -> DashScope tongyi-embedding (native SDK)
#
# -- DeepSeek (text + copilot) --
DEEPSEEK_API_KEY=sk-replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_REQUEST_TIMEOUT=180
# Text model used for the structured lecture (lecturize + IR + Critic).
# Default: deepseek-v4-flash — cheap, low-latency, long 1M context.
# Alternative: deepseek-v4-pro — denser IR but ~3x cost.
QWEN_TEXT_MODEL=deepseek-v4-flash
# Toggle the backend's "thinking" / chain-of-thought mode. Must stay
# false for DeepSeek: their reasoning_content cannot round-trip through
# langchain-openai, which would break the Copilot ReAct second turn
# with "reasoning_content in the thinking mode must be passed back".
# Setting this true is only meaningful on DashScope-Qwen-style backends.
QWEN_TEXT_ENABLE_THINKING=false

# -- DashScope (VLM + embeddings) --
DASHSCOPE_API_KEY=sk-replace-me
# Vision model used for keyframe captioning + board-OCR.
# Default: qwen3.5-omni-plus (DashScope native multimodal).
QWEN_VL_MODEL=qwen3.5-omni-plus
# Concurrency for VLM keyframe description calls (1-16). Higher values
# can shorten the VLM stage but may trigger DashScope rate limits.
QWEN_VL_CONCURRENCY=4
# DashScope OpenAI-compatible base URL
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_REQUEST_TIMEOUT=180

# ---- VLM tiering & cache (M3) ----
# Two-tier prompting routes informative frames (code, formulas,
# distinct slides) to the full caption+OCR prompt and demotes
# duplicate / near-blank / talking-head frames to a much cheaper
# OCR-only prompt. Set VLM_TIERING_ENABLED=false to bypass the
# classifier and send every frame through the HIGH-tier prompt
# (legacy behaviour). VLM_TIERING_HIGH_FLOOR_RATIO guarantees at
# least this fraction of *non-junk* frames stay HIGH, so visually
# rich videos do not silently lose information.
VLM_TIERING_ENABLED=true
VLM_TIERING_HIGH_FLOOR_RATIO=0.5
VLM_JUNK_SIM_THRESHOLD=0.93
VLM_JUNK_ENTROPY_THRESHOLD=2.0
# Content-addressed SQLite cache keyed by (sha256(image), model,
# tier). Adding one new keyframe to a BV no longer forces a full
# re-run; identical slides across videos hit the same row. Disable
# with VLM_CACHE_ENABLED=false for A/B comparisons. VLM_CACHE_PATH
# defaults to <DATA_DIR>/vlm_cache.sqlite when blank.
VLM_CACHE_ENABLED=true
# VLM_CACHE_PATH=

# ---- Whisper fallback (only used when no CC subtitle) ----
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ---- Auth ----
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=change-me-please

# ---- Service ----
APP_HOST=0.0.0.0
APP_PORT=8000
DATA_DIR=./data
MAX_CONCURRENT_JOBS=2

# ---- Ingest ----
KEYFRAME_MIN=8
KEYFRAME_MAX=20
KEYFRAME_THRESHOLD=27.0
# When true (default) KEYFRAME_MIN/MAX become *floors*; long videos get
# proportionally more frames so per-minute visual evidence stays stable.
KEYFRAME_LENGTH_ADAPT=true
# Path to a Netscape-format cookies.txt for B 站 (yt-dlp can export one)
BILIBILI_COOKIE_FILE=./data/cookies/bilibili.txt

# ---- Lecture generation v2 (multi-agent + question-driven) ----
# Pre-generate problem-first study questions and feed them into the IR
# builder; falls back to single-pass if the question agent fails.
LECTURE_QUESTION_DRIVEN=true
# When true (default), the StudyQuestionAgent samples subtitles and frames
# from multiple windows (head + mid + tail) instead of only the first
# ~5 minutes, so questions for long videos cover the whole timeline.
# Set false to recover the legacy head-only sampling for A/B testing.
LECTURE_STUDY_QUESTION_MULTI_WINDOW=true
# Run the Critic stage after the initial IR build. The Critic audits
# coverage / missing code / dubious quotes and writes its findings into
# pipeline_stats.critique. It does NOT rewrite the IR by itself.
LECTURE_CRITIC_ENABLED=true
# Legacy on/off switch for the Critic-Reviser loop. Kept for back-compat
# with M1 deployments. When LECTURE_REVISER_MODE is *not* explicitly set,
# this flag is mapped at load-time to mode='full' (true) or mode='off'
# (false). Prefer setting LECTURE_REVISER_MODE directly.
LECTURE_REVISER_ENABLED=false
# Reviser dispatch mode (M2). 'off' disables the Reviser while still
# letting the Critic audit the IR. 'patch' applies a whitelist of
# structured edits returned by the Reviser (introduced in M2.P6 — not
# yet implemented; selecting it before P6 lands behaves like 'off').
# 'full' rewrites the entire IR (legacy behaviour, slowest path). When
# unset, derived from LECTURE_REVISER_ENABLED above for back-compat.
# LECTURE_REVISER_MODE=patch
# Max critic→reviser rounds (0 disables the loop, 1 is the recommended default).
LECTURE_CRITIC_MAX_ROUNDS=1
# Soft cap on the Critic *subtitle excerpt* size in characters (NOT the
# total prompt — the IR JSON is the artefact being audited and is
# irreducible). When > 0 the Critic projects subtitles against the IR
# structure (chapter windows + point/code/formula/visual anchor
# neighborhoods) and uniformly downsamples segments only when the
# formatted subtitle block would still exceed this budget. Frames are
# independently capped at 16 (short / medium) or 24 (long). Set 0 to
# disable both projection and trimming and recover the legacy full
# subtitle behaviour.
LECTURE_CRITIC_MAX_PROMPT_CHARS=24000
LECTURE_REVISER_TIMEOUT=600
LECTURE_STRICT_AGENTS=true
# Code highlighter for the rendered HTML: 'highlight.js' (recommended) or '' to disable.
LECTURE_CODE_HIGHLIGHTER=highlight.js
# Above this duration future map-reduce stages will activate (currently just a hint).
LECTURE_MAP_REDUCE_THRESHOLD_SEC=1200
# M2 length-aware routing thresholds (seconds). Three ascending integers
# splitting tiny / standard / long / epic profiles. Boundary belongs to
# the upper bucket: 180 → standard, 900 → long, 3600 → epic.
# Defaults: <3min tiny / 3-15min standard / 15-60min long / 60+min epic.
# 2026-05-12 lowered standard upper bound from 1500 (25min) to 900
# (15min) so standard's single-call IR JSON stays under the 8192-token
# DeepSeek output cap. Real-machine BV1ypdgBCE9B (23min) was triggering
# `LLM truncated LectureIR JSON (finish_reason=length)` at the old
# threshold. The auto-fallback below is the safety net for sub-15min
# code-dense outliers that still slip through.
LECTURE_PROFILE_THRESHOLDS_SEC=180,900,3600
# M2.P2 ChapterPlanner — deterministic chapter-anchor extraction.
# Enabled by default; only fires for videos >= MIN_SEC. Three signals
# combine into anchor candidates (transition-phrase regex / silence
# gap / visual-type shift) with the per-signal default confidences
# below. Hint mode (tiny/standard) feeds these as suggestions to the
# LLM; structural mode (long/epic) enforces them as chapter boundaries.
LECTURE_CHAPTER_PLANNER_ENABLED=true
LECTURE_CHAPTER_PLANNER_MIN_SEC=60
LECTURE_PLANNER_SILENCE_SEC=6.0
LECTURE_PLANNER_TRANSITION_PHRASE_CONFIDENCE=0.85
LECTURE_PLANNER_SILENCE_CONFIDENCE=0.6
LECTURE_PLANNER_VISUAL_SHIFT_CONFIDENCE=0.55
# M2.2 architectural safeguard against single chapters being too long for
# the downstream map-chapter LLM call. After the planner produces its
# chapter list, any chapter whose width exceeds this threshold gets
# bisected into ceil(width/threshold) equal sub-chapters tagged with
# source='equal_split_overflow'. Default 720s (12min) keeps each chapter
# under DeepSeek's 8192-token single-call output cap on code-dense
# content. Real-machine BV1ypdgBCE9B produced a 17min 43s chapter that
# silently truncated to "本章内容生成失败" before this safeguard landed.
# Set 0 to disable (not recommended).
LECTURE_CHAPTER_MAX_DURATION_SEC=720
# M2.P3 ChapterCache — per-chapter SQLite cache used by the map-reduce
# IR builder (P4). Key is a SHA-256 of (segments + frames + boundaries
# + model + prompt version) so editing one subtitle line only
# invalidates the affected chapter; bumping LECTURE_MAP_PROMPT_VERSION
# invalidates everything at once. Set ENABLED=false for A/B or
# emergency disable; PATH defaults to <DATA_DIR>/chapter_cache.sqlite
# when blank.
LECTURE_CHAPTER_CACHE_ENABLED=true
# LECTURE_CHAPTER_CACHE_PATH=
LECTURE_MAP_PROMPT_VERSION=m2-map-v1
# M2.P4 MapReduceIRBuilder — long/epic profile chapter map-reduce.
# Map: per-chapter LLM call with one retry; failed chapters drop a
# "本章生成失败" placeholder so the pipeline still produces a usable IR.
# Reduce-global: single LLM call that emits lecture_summary / mainline /
# glossary_resolved / cross_references; fails fast (no degraded fallback)
# after MAX_RETRIES exhausts so a re-run only pays the global cost.
LECTURE_MAP_CHAPTER_MAX_RETRIES=1
LECTURE_MAP_CHAPTER_TIMEOUT=180
# M2.2 truncation safety net for the per-chapter map call. Aligned with
# LECTURE_IR_MAX_TOKENS / LECTURE_REVISER_MAX_TOKENS /
# LECTURE_REDUCE_GLOBAL_MAX_TOKENS so every LLM call on the map-reduce
# path shares the same 8192-token ceiling (DeepSeek's hard upper bound).
# Pre-M2.2 the call passed no max_tokens and DeepSeek defaulted to ~4096,
# causing BV1ypdgBCE9B chapter 5 (17min 43s) to truncate silently. Set
# 0 to fall back to the backend default.
LECTURE_MAP_CHAPTER_MAX_TOKENS=8192
LECTURE_REDUCE_GLOBAL_TIMEOUT=120
LECTURE_REDUCE_GLOBAL_MAX_RETRIES=1
LECTURE_REDUCE_GLOBAL_MAX_TOKENS=4000
# Max output tokens for the single-call LectureIR build (tiny / standard
# profile). DeepSeek's per-call default is 4096, which truncates 20+ minute
# code-heavy videos mid-JSON and surfaces as
# `LLM returned non-JSON LectureIR: Expecting ',' delimiter ...`. 8192
# matches DeepSeek's per-call ceiling; set 0 to fall back to the backend
# default.
LECTURE_IR_MAX_TOKENS=8192
# Max output tokens for the full-rewrite Reviser path
# (LECTURE_REVISER_MODE=full or M1 legacy fallback). The full Reviser
# regenerates an entire IR JSON so it inherits the same 4096-default
# truncation risk as the IR builder. The patch-mode Reviser (default
# for standard / long / epic profiles) is bounded by issue count and
# ignores this knob. Set 0 to fall back to the backend default.
LECTURE_REVISER_MAX_TOKENS=8192
# Architectural safety net for the single-call IR builder. When the
# LLM hits `finish_reason='length'` and the JSON tail is therefore
# unterminated, the pipeline normally raises `LLM truncated LectureIR
# JSON`. With this flag on (default), the build instead retries via
# `MapReduceIRBuilder` using the existing chapter_plan and an
# on-demand ChapterCache, so the user gets a successful IR even when
# the 8192-token cap is still too small for a code-dense lecture.
# Disable only when debugging a truncation root cause and you want the
# original error to surface immediately.
LECTURE_IR_AUTO_FALLBACK_TO_MAP_REDUCE=true
# M2.P5 per-profile Critic timeouts (consumed by P7 audit wiring; the
# legacy critique() path keeps using LECTURE_CRITIC_TIMEOUT above).
# full = standard profile (full segments + frames + IR);
# projected = long/epic profile (lecture-level only, smaller prompt).
LECTURE_CRITIC_FULL_TIMEOUT=180
LECTURE_CRITIC_PROJECTED_TIMEOUT=120
# M2.P6 patch Reviser prompt version. Bump whenever the patch
# whitelist / examples in LECTURE_REVISER_PATCH_SYSTEM change so
# matrix reports can pin behaviour to a specific revision.
LECTURE_REVISER_PROMPT_VERSION=m2-patch-v1
# When true (default), pipeline.run() awaits Copilot RAG indexing before
# returning. Set to false to run RAG indexing as a fire-and-forget
# background task and return the report path sooner (dev preview).
PIPELINE_WAIT_RAG=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Copilot + MCP (v1) ----
# Conversational lecture agent LLM. Shares the DeepSeek endpoint with
# the text pipeline; deepseek-v4-flash is the recommended default.
QWEN_COPILOT_MODEL=deepseek-v4-flash
# Multi-modal embedding model used for RAG (DashScope native SDK)
QWEN_EMBEDDING_MODEL=tongyi-embedding-vision-flash-2026-03-06
# Stage-2 toggle: also embed keyframe images directly (cross-modal). Default false.
COPILOT_FRAME_VISION_EMBED=false
# Hard ceiling on tool calls per single Copilot turn
COPILOT_MAX_TOOL_CALLS=6
# Global concurrency for Copilot ask requests
COPILOT_MAX_CONCURRENT=4
# Optional Bocha web search key for Copilot learning extensions ([[extension]] section)
BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bochaai.com/v1/web-search
# Required when running MCP Server in SSE mode; stdio ignores it.
MCP_SERVER_TOKEN=
# Set to true to expose summarize_video over MCP (off by default to avoid abuse)
MCP_EXPOSE_SUMMARIZE=false
