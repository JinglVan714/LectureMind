<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ lecture.title }} · LectureMind 讲义</title>
  {% if katex_assets_available %}
  <link rel="stylesheet" href="assets/katex/katex.min.css" />
  {% endif %}
  {% if highlight_assets_available %}
  <link rel="stylesheet" href="assets/highlight/atom-one-light.min.css" />
  {% elif highlight_cdn_url %}
  <link rel="stylesheet" href="{{ highlight_cdn_css }}" crossorigin="anonymous" />
  {% endif %}
  <style>
{{ css_inline }}
  </style>
  {% if copilot_css_inline %}
  <style>
{{ copilot_css_inline }}
  </style>
  {% endif %}
</head>
<body data-bv="{{ lecture.bv_id }}">
  <a class="topbar-back" href="/">← 返回讲义库</a>

  <header class="cover">
    {% if cover_url %}
    <div class="cover-img" style="background-image:url('{{ cover_url }}')"></div>
    {% endif %}
    <div class="cover-meta">
      <h1>{{ lecture.title | rich_text }}</h1>
      <div class="meta-line">
        <span>UP {{ lecture.author }}</span>
        <span>·</span>
        <span>时长 {{ lecture.duration | fmt_dur }}</span>
        {% if summary_mode %}<span>·</span><span>{{ summary_mode }}</span>{% endif %}
        <span>·</span>
        <a href="{{ bili_link(lecture.bv_id, 0) }}" target="_blank" rel="noopener">原视频 ↗</a>
      </div>
      {% if cover_one_liner %}
      <p class="one-liner">{{ cover_one_liner | rich_text }}</p>
      {% endif %}
      {% if lecture.core_question %}
      <div class="hero-question">
        <span>核心问题</span>
        <p>{{ lecture.core_question | rich_text }}</p>
      </div>
      {% endif %}
      {% if lecture.domain_tags %}
      <div class="tags">
        {% for tag in lecture.domain_tags %}<span class="tag">#{{ tag }}</span>{% endfor %}
      </div>
      {% endif %}
    </div>
  </header>

  <nav class="chapter-nav" aria-label="讲义导航">
    <ol>
      {% if note_projection.has_units %}
      {% for unit in note_projection.teaching_units %}
      <li><a href="#{{ unit.id }}">{{ unit.title | rich_text }}</a></li>
      {% endfor %}
      {% if evidence_projection.has_items %}<li><a href="#source-index">来源索引</a></li>{% endif %}
      {% else %}
      {% for ch in lecture.chapters %}
      <li><a href="#chapter-{{ ch.index }}"><span class="num">{{ ch.index }}</span>{{ ch.title | rich_text }}</a></li>
      {% endfor %}
      {% endif %}
    </ol>
  </nav>

  <main class="content">
    {% if mainline_items and not note_projection.has_units %}
    <section class="mainline-section">
      <h2>主线推进路径</h2>
      <div class="mainline-steps">
        {% for item in mainline_items %}
        <article class="mainline-step">
          <span class="path-step">{{ loop.index }}</span>
          <p>{{ item | rich_text }}</p>
        </article>
        {% endfor %}
      </div>
      {% if timeline_turning_points or timeline_state_evolution %}
      <details class="mainline-details">
        <summary>展开关键转折与信息演化</summary>
        {% if timeline_turning_points %}
        <div class="timeline-subsection">
          <h3>关键转折</h3>
          <div class="timeline-detail-list">
            {% for item in timeline_turning_points %}
            <article class="timeline-detail-item{% if not item.time %} no-time{% endif %}">
              {% if item.time %}<span class="timeline-time">{{ item.time }}</span>{% endif %}
              <p>{{ item.text | rich_text }}</p>
            </article>
            {% endfor %}
          </div>
        </div>
        {% endif %}
        {% if timeline_state_evolution %}
        <div class="timeline-subsection">
          <h3>信息演化</h3>
          <div class="timeline-detail-list">
            {% for item in timeline_state_evolution %}
            <article class="timeline-detail-item{% if not item.time %} no-time{% endif %}">
              {% if item.time %}<span class="timeline-time">{{ item.time }}</span>{% endif %}
              <p>{{ item.text | rich_text }}</p>
            </article>
            {% endfor %}
          </div>
        </div>
        {% endif %}
      </details>
      {% endif %}
    </section>
    {% endif %}

    {% if lecture.study_questions and not note_projection.has_units %}
    <section class="study-questions">
      <h2>读完后你应当能回答</h2>
      <ol>
        {% for q in lecture.study_questions %}
        <li>{{ q | rich_text }}</li>
        {% endfor %}
      </ol>
    </section>
    {% endif %}

    {% if note_projection.has_units %}
    <section class="handout-overview">
      <div class="handout-overview-head">
        <div>
          <span class="section-kicker">先读这里</span>
          <h2>这份讲义该怎么读</h2>
        </div>
        {% if note_projection.audience_fit %}
        <p class="overview-fit">{{ note_projection.audience_fit | rich_text }}</p>
        {% endif %}
      </div>
      {% if note_projection.front_matter.reader_orientation %}
      <div class="body-section-summary rich-text">{{ note_projection.front_matter.reader_orientation | rich_text }}</div>
      {% endif %}
      <div class="overview-grid">
        {% if note_projection.front_matter.takeaways_top %}
        <article class="overview-card">
          <h3>最值得带走的几点</h3>
          <ol>
            {% for item in note_projection.front_matter.takeaways_top %}
            <li>{{ item | rich_text }}</li>
            {% endfor %}
          </ol>
        </article>
        {% endif %}
        <article class="overview-card">
          <h3>如果只读 3 分钟</h3>
          <ul>
            {% for unit in note_projection.teaching_units[:3] %}
            <li><a href="#{{ unit.id }}">{{ unit.title | rich_text }}</a></li>
            {% endfor %}
          </ul>
        </article>
      </div>
    </section>

    <section class="handout-body">
      <div class="handout-phase">
        <span>正文展开</span>
      </div>
      {% for unit in note_projection.teaching_units %}
      <article class="body-section body-section-{{ unit.unit_role }}" id="{{ unit.id }}"
               data-ref-kind="note" data-note-node-id="{{ unit.id }}"
               {% if unit.source_chapter_refs %}data-source-chapters="{{ unit.source_chapter_refs | join(',') }}"{% endif %}
               {% if unit.evidence_refs %}data-evidence-id="{{ unit.evidence_refs[0] }}"{% endif %}>
        <header class="body-section-head">
          <div class="body-section-heading">
            {% if unit.transition_from_previous %}
            <p class="section-ref">{{ unit.transition_from_previous | rich_text }}</p>
            {% endif %}
            <div class="body-section-title-row">
              <span class="chapter-no">{{ unit.ordinal }}</span>
              <div class="body-section-title-copy">
                <h2>{{ unit.title | rich_text }}</h2>
              </div>
            </div>
          </div>
          {% if unit.evidence_refs or unit.primary_timestamp %}
          <div class="body-section-meta" aria-label="引用与时间锚点">
            {% if unit.evidence_refs %}<span class="meta-chip meta-chip-ref">引用 {{ unit.evidence_refs | length }}</span>{% endif %}
            {% if unit.primary_timestamp %}
            <a class="meta-chip meta-chip-link" href="{{ bili_link(lecture.bv_id, unit.primary_timestamp) }}" target="_blank" rel="noopener">
              {{ unit.primary_timestamp | fmt_ts }} · 回到视频
            </a>
            {% endif %}
          </div>
          {% endif %}
        </header>
        {% if unit.core_message %}
        <div class="body-section-summary rich-text">{{ unit.core_message | rich_text }}</div>
        {% endif %}
        {% for block in unit.content_blocks %}
        <section class="outline-block" id="{{ block.id }}"
                 data-ref-kind="note" data-note-node-id="{{ block.id }}"
                 {% if block.evidence_refs %}data-evidence-id="{{ block.evidence_refs[0] }}"{% endif %}>
          {% if block.show_head %}
          <header class="outline-block-head">
            <div class="outline-block-title-row">
              {% if block.show_ordinal %}
              <span class="outline-block-ordinal">{{ block.ordinal }}</span>
              {% endif %}
              {% if block.title %}
              <h3>{{ block.title | rich_text }}</h3>
              {% endif %}
            </div>
            {% if block.source_timestamps or block.evidence_refs %}
            <div class="outline-block-meta" aria-label="引用与时间锚点">
              {% if block.evidence_refs %}<span class="meta-chip meta-chip-ref">引用 {{ block.evidence_refs | length }}</span>{% endif %}
              {% if block.source_timestamps %}
              <div class="outline-block-timestamps" aria-label="时间锚点">
                {% for ts in block.source_timestamps %}
                <a class="ts-anchor" href="{{ bili_link(lecture.bv_id, ts) }}" target="_blank" rel="noopener">{{ ts | fmt_ts }}</a>
                {% endfor %}
              </div>
              {% endif %}
            </div>
            {% endif %}
          </header>
          {% endif %}
          {% if not block.show_head and block.title %}
          <p class="outline-block-topic">{{ block.title | rich_text }}</p>
          {% endif %}
          {% if block.lead %}
          <p class="outline-block-lead">{{ block.lead | rich_text }}</p>
          {% endif %}
          {% for paragraph in block.paragraphs %}
          <div class="rich-paragraph outline-block-paragraph">{{ paragraph | rich_text }}</div>
          {% endfor %}
          {% if not block.show_head and (block.source_timestamps or block.evidence_refs) %}
          <div class="outline-block-meta outline-block-meta-inline" aria-label="引用与时间锚点">
            {% if block.evidence_refs %}<span class="meta-chip meta-chip-ref">引用 {{ block.evidence_refs | length }}</span>{% endif %}
            {% if block.source_timestamps %}
            <div class="outline-block-timestamps" aria-label="时间锚点">
              {% for ts in block.source_timestamps %}
              <a class="ts-anchor" href="{{ bili_link(lecture.bv_id, ts) }}" target="_blank" rel="noopener">{{ ts | fmt_ts }}</a>
              {% endfor %}
            </div>
            {% endif %}
          </div>
          {% endif %}
        </section>
        {% endfor %}
        {% if unit.visual_slots %}
        <section class="section-visuals-spotlight">
          {% set primary_visual = unit.visual_slots[0] %}
          <figure class="frame frame-spotlight"
                  data-ref-kind="evidence"
                  {% if primary_visual.evidence_refs %}data-evidence-id="{{ primary_visual.evidence_refs[0] }}"{% endif %}
                  data-note-node-id="{{ unit.id }}">
            <img src="{{ frame_url(primary_visual.path) }}" alt="frame at {{ primary_visual.ts | fmt_ts }}" loading="lazy" />
            <figcaption>
              <div class="visual-meta">
                <span class="visual-eyebrow">关键画面</span>
                <a class="visual-time" href="{{ bili_link(lecture.bv_id, primary_visual.ts) }}" target="_blank" rel="noopener">{{ primary_visual.ts | fmt_ts }}</a>
              </div>
              <div class="visual-copy">
                {% if primary_visual.title %}<h4>{{ primary_visual.title | rich_text }}</h4>{% endif %}
                {% if primary_visual.caption %}<p>{{ primary_visual.caption | rich_text }}</p>{% endif %}
              </div>
            </figcaption>
          </figure>
          {% if unit.visual_slots | length > 1 %}
          <details class="section-visuals-more">
            <summary>需要时展开更多画面</summary>
            <div class="frame-strip section-visuals section-visuals-secondary">
              {% for visual in unit.visual_slots[1:] %}
              <figure class="frame frame-compact"
                      data-ref-kind="evidence"
                      {% if visual.evidence_refs %}data-evidence-id="{{ visual.evidence_refs[0] }}"{% endif %}
                      data-note-node-id="{{ unit.id }}">
                <img src="{{ frame_url(visual.path) }}" alt="frame at {{ visual.ts | fmt_ts }}" loading="lazy" />
                <figcaption>
                  <div class="visual-meta">
                    <span class="visual-eyebrow">补充画面</span>
                    <a class="visual-time" href="{{ bili_link(lecture.bv_id, visual.ts) }}" target="_blank" rel="noopener">{{ visual.ts | fmt_ts }}</a>
                  </div>
                  <div class="visual-copy">
                    {% if visual.title %}<h4>{{ visual.title | rich_text }}</h4>{% endif %}
                    {% if visual.caption %}<p>{{ visual.caption | rich_text }}</p>{% endif %}
                  </div>
                </figcaption>
              </figure>
              {% endfor %}
            </div>
          </details>
          {% endif %}
        </section>
        {% endif %}
      </article>
      {% endfor %}
    </section>
    {% if note_projection.back_matter.boundary_and_risks %}
    <section class="study-questions">
      <h2>边界与风险</h2>
      <ul>
        {% for item in note_projection.back_matter.boundary_and_risks %}
        <li>{{ item | rich_text }}</li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}

    {% if note_projection.back_matter.term_quick_ref %}
    <section class="study-questions">
      <h2>术语速查</h2>
      <ul>
        {% for item in note_projection.back_matter.term_quick_ref %}
        <li>
          <strong>{{ item.term }}</strong>：{{ item.explanation | rich_text }}
          {% if item.ts %}<a class="ts-anchor" href="{{ bili_link(lecture.bv_id, item.ts) }}" target="_blank" rel="noopener">{{ item.ts | fmt_ts }}</a>{% endif %}
        </li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}

    {% if note_projection.back_matter.appendices %}
    <section class="study-questions">
      <h2>补充说明</h2>
      <ul class="appendix-list">
        {% for item in note_projection.back_matter.appendices %}
        <li class="appendix-item">
          {% if item.title %}<strong>{{ item.title | rich_text }}</strong>{% endif %}
          {% if item.kind_label %}<span class="appendix-kind">{{ item.kind_label }}</span>{% endif %}
          <p>{{ item.summary | rich_text }}</p>
        </li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}

    {% if note_projection.back_matter.transfer_and_next_steps %}
    <section class="study-questions">
      <h2>迁移与下一步</h2>
      <ol>
        {% for item in note_projection.back_matter.transfer_and_next_steps %}
        <li>{{ item | rich_text }}</li>
        {% endfor %}
      </ol>
    </section>
    {% endif %}
    {% else %}
    {% for ch in lecture.chapters %}
    <section class="chapter" id="chapter-{{ ch.index }}"
             data-ref-kind="chapter" data-ref-id="{{ ch.index }}"
             data-ch-start="{{ ch.start | int }}" data-ch-end="{{ ch.end | int }}">
      <header class="chapter-head">
        <div>
          <span class="chapter-no">章节 {{ ch.index }}</span>
          <h2>{{ ch.title | rich_text }}</h2>
        </div>
        <a class="anchor-btn" href="{{ bili_link(lecture.bv_id, ch.start) }}" target="_blank" rel="noopener">
          {{ ch.start | fmt_ts }} – {{ ch.end | fmt_ts }} · 在 B 站定位看 ↗
        </a>
      </header>

      {% if ch.learning_goal %}
      <div class="learning-goal">
        <span>本章问题</span>
        <p>{{ ch.learning_goal | rich_text }}</p>
      </div>
      {% endif %}

      {% if ch.summary %}
      <div class="chapter-summary rich-text">{{ ch.summary | rich_text }}</div>
      {% endif %}

      {% if ch.teaching_notes %}
      <div class="teaching-notes">
        <h3>讲解</h3>
        {% for note in ch.teaching_notes %}
        <div class="rich-paragraph">{{ note | rich_text }}</div>
        {% endfor %}
      </div>
      {% endif %}

      {% if ch.process_steps %}
      <div class="process-steps">
        <h3>过程拆解</h3>
        <ol>
          {% for step in ch.process_steps %}
          <li>{{ step | rich_text }}</li>
          {% endfor %}
        </ol>
      </div>
      {% endif %}

      {% if ch.frames %}
      <div class="frame-strip">
        {% for fr in ch.frames %}
        <figure class="frame frame-compact"
                {% if frame_id_map and fr.path in frame_id_map %}id="frame-{{ frame_id_map[fr.path] }}" data-ref-kind="frame" data-ref-id="{{ frame_id_map[fr.path] }}"{% endif %}>
          <img src="{{ frame_url(fr.path) }}" alt="frame at {{ fr.ts | fmt_ts }}" loading="lazy" />
          <figcaption>
            <a href="{{ bili_link(lecture.bv_id, fr.ts) }}" target="_blank" rel="noopener">⚓ {{ fr.ts | fmt_ts }}</a>
            {% if frame_id_map and fr.path in frame_id_map %}<span class="frame-id">F{{ frame_id_map[fr.path] }}</span>{% endif %}
            {% if fr.visual_type %}<span class="visual-type">{{ fr.visual_type }}</span>{% endif %}
            {% if fr.caption %} · {{ fr.caption | rich_text }}{% endif %}
          </figcaption>
        </figure>
        {% endfor %}
      </div>
      {% endif %}

      {% set evidence = namespace(has_frame_details=false) %}
      {% for fr in ch.frames %}
        {% if fr.insight or fr.selected_reason or fr.ocr_text %}
          {% set evidence.has_frame_details = true %}
        {% endif %}
      {% endfor %}
      {% if evidence.has_frame_details or ch.points %}
      <details class="evidence-details">
        <summary>展开证据与引文</summary>
        {% if evidence.has_frame_details %}
        <div class="evidence-group">
          <h4>图像补充</h4>
          {% for fr in ch.frames %}
          {% if fr.insight or fr.selected_reason or fr.ocr_text %}
          <article class="evidence-item">
            <a class="ts-anchor" href="{{ bili_link(lecture.bv_id, fr.ts) }}" target="_blank" rel="noopener">⚓ {{ fr.ts | fmt_ts }}</a>
            {% if fr.selected_reason or fr.insight %}
            <p>{{ (fr.selected_reason or fr.insight) | rich_text }}</p>
            {% endif %}
            {% if fr.ocr_text %}
            <details class="frame-ocr">
              <summary>画面 OCR</summary>
              <pre>{{ fr.ocr_text }}</pre>
            </details>
            {% endif %}
          </article>
          {% endif %}
          {% endfor %}
        </div>
        {% endif %}
        {% if ch.points %}
        <div class="evidence-group">
          <h4>论点与引文</h4>
          <ul class="points">
            {% for p in ch.points %}
            <li class="point point-compact">
              <div class="point-row">
                <span class="point-text">{{ p.text | rich_text }}</span>
                <a class="ts-anchor" href="{{ bili_link(lecture.bv_id, p.ts) }}" target="_blank" rel="noopener">⚓ {{ p.ts | fmt_ts }}</a>
              </div>
              {% if p.quote %}
              <blockquote>{{ p.quote | rich_text }}</blockquote>
              {% endif %}
            </li>
            {% endfor %}
          </ul>
        </div>
        {% endif %}
      </details>
      {% endif %}

      {% if ch.pitfalls %}
      <div class="pitfalls">
        <h3>易错点</h3>
        <ul>
          {% for item in ch.pitfalls %}
          <li>{{ item | rich_text }}</li>
          {% endfor %}
        </ul>
      </div>
      {% endif %}

      {% if ch.key_takeaways %}
      <div class="key-takeaways">
        <h3>本章关键结论</h3>
        <ul>
          {% for item in ch.key_takeaways %}
          <li>{{ item | rich_text }}</li>
          {% endfor %}
        </ul>
      </div>
      {% endif %}

      {% if ch.code_blocks and lecture.render_plan.code_section %}
      <div class="code-blocks">
        <h3>代码片段</h3>
        {% for cb in ch.code_blocks %}
        <figure class="code-card">
          <header class="code-card-head">
            <span class="code-lang">{{ cb.language or 'text' }}</span>
            <a class="ts-anchor" href="{{ bili_link(lecture.bv_id, cb.ts) }}" target="_blank" rel="noopener">⚓ {{ cb.ts | fmt_ts }}</a>
            {% if cb.source %}<span class="code-source">{{ cb.source }}</span>{% endif %}
          </header>
          <pre class="code-block"><code class="language-{{ cb.language or 'text' }}">{{ cb.code }}</code></pre>
          {% if cb.explanation %}
          <figcaption>{{ cb.explanation | rich_text }}</figcaption>
          {% endif %}
        </figure>
        {% endfor %}
      </div>
      {% endif %}

      {% if ch.formula_blocks and lecture.render_plan.formula_section %}
      <div class="formula-blocks">
        <h3>公式</h3>
        {% for fb in ch.formula_blocks %}
        <figure class="formula-card">
          <a class="ts-anchor" href="{{ bili_link(lecture.bv_id, fb.ts) }}" target="_blank" rel="noopener">⚓ {{ fb.ts | fmt_ts }}</a>
          <div class="formula-latex">$${{ fb.latex }}$$</div>
          {% if fb.explanation %}
          <figcaption>{{ fb.explanation | rich_text }}</figcaption>
          {% endif %}
        </figure>
        {% endfor %}
      </div>
      {% endif %}
    </section>
    {% endfor %}
    {% endif %}

    {% if evidence_projection.has_items %}
    <section class="source-index" id="source-index">
      <div class="source-index-head">
        <div>
          <span class="section-kicker">证据与来源</span>
          <h2>默认先读正文，核对时再展开</h2>
        </div>
        <p class="source-index-intro">
          {% if note_projection.back_matter.source_index_entrypoints %}
          证据回到这些单元：{{ note_projection.back_matter.source_index_entrypoints[:3] | join('、') }}
          {% else %}
          只在需要核对时间点、术语原文或证据出处时再展开。
          {% endif %}
        </p>
      </div>
      {% if evidence_projection.source_index_view %}
      <details class="source-index-group">
        <summary>证据如何回到讲义主线</summary>
        <ul>
          {% for item in evidence_projection.source_index_view %}
          <li class="source-index-item"
              data-ref-kind="evidence"
              {% if item.evidence_id %}data-evidence-id="{{ item.evidence_id }}"{% endif %}
              {% if item.page_anchor %}data-note-node-id="{{ item.page_anchor }}"{% endif %}>
            {% if item.video_anchor %}
            <a href="{{ bili_link(lecture.bv_id, item.video_anchor | replace('t=', '') | int) }}" target="_blank" rel="noopener">{{ item.label }}</a>
            {% else %}
            <span class="source-label">{{ item.label }}</span>
            {% endif %}
            {% if item.supports_text %}<span class="source-support"> · {{ item.supports_text | rich_text }}</span>{% endif %}
          </li>
          {% endfor %}
        </ul>
      </details>
      {% endif %}
      {% if evidence_projection.chapter_map %}
      <details class="source-index-group">
        <summary>章节定位</summary>
        <ul>
          {% for item in evidence_projection.chapter_map %}
          <li>
            <a class="ts-anchor" href="{{ bili_link(lecture.bv_id, item.start) }}" target="_blank" rel="noopener">{{ item.start | fmt_ts }}</a>
            第 {{ item.chapter_index }} 章 · {{ item.title | rich_text }}
          </li>
          {% endfor %}
        </ul>
      </details>
      {% endif %}
      {% if evidence_projection.evidence_quotes %}
      <details class="source-index-group">
        <summary>关键证据</summary>
        <ul class="points">
          {% for item in evidence_projection.evidence_quotes %}
          <li class="point point-compact">
            <div class="point-row">
              <a class="ts-anchor" href="{{ bili_link(lecture.bv_id, item.ts) }}" target="_blank" rel="noopener">{{ item.ts | fmt_ts }}</a>
              {% if item.chapter_index %}<span class="point-text">第 {{ item.chapter_index }} 章</span>{% endif %}
            </div>
            {% if item.label %}<p>{{ item.label | rich_text }}</p>{% endif %}
            <blockquote>{{ item.quote | rich_text }}</blockquote>
          </li>
          {% endfor %}
        </ul>
      </details>
      {% endif %}
      {% if evidence_projection.term_index %}
      <details class="source-index-group">
        <summary>术语速查</summary>
        <dl>
          {% for item in evidence_projection.term_index %}
          <dt>
            <a class="ts-anchor" href="{{ bili_link(lecture.bv_id, item.ts) }}" target="_blank" rel="noopener">{{ item.ts | fmt_ts }}</a>
            <strong>{{ item.term | rich_text }}</strong>
          </dt>
          {% if item.explanation %}<dd>{{ item.explanation | rich_text }}</dd>{% endif %}
          {% endfor %}
        </dl>
      </details>
      {% endif %}
      {% if evidence_projection.appendix_view %}
      <details class="source-index-group">
        <summary>补充材料</summary>
        <ul>
          {% for item in evidence_projection.appendix_view %}
          <li>
            {% if item.title %}<strong>{{ item.title | rich_text }}</strong>{% endif %}
            {% if item.kind %}<span> · {{ item.kind }}</span>{% endif %}
          </li>
          {% endfor %}
        </ul>
      </details>
      {% endif %}
    </section>
    {% endif %}

    {% if lecture.glossary and not evidence_projection.term_index %}
    <section class="glossary">
      <h2>术语速查</h2>
      <dl>
        {% for g in lecture.glossary %}
        <dt>
          <a href="{{ bili_link(lecture.bv_id, g.ts) }}" target="_blank" rel="noopener">⚓ {{ g.ts | fmt_ts }}</a>
          <strong>{{ g.term | rich_text }}</strong>
        </dt>
        {% if g.explanation %}<dd>{{ g.explanation | rich_text }}</dd>{% endif %}
        {% endfor %}
      </dl>
    </section>
    {% endif %}

    {% if lecture.final_synthesis and not note_projection.has_units %}
    <section class="final-synthesis">
      <h2>最终综合</h2>
      <div class="synthesis-body">{{ lecture.final_synthesis | rich_text }}</div>
    </section>
    {% endif %}

    {% if review_questions_to_render and not note_projection.has_units %}
    <section class="review-questions">
      <h2>复习问题</h2>
      <ul>
        {% for q in review_questions_to_render %}
        <li>{{ q | rich_text }}</li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}

    {% if lecture.render_plan.completeness_card and not note_projection.has_units %}
    <section class="completeness-card">
      <div>
        <h2>学习闭环检查</h2>
        <p>{{ (lecture.completeness.notes or "已检查主线闭环、图文材料和可复用知识单元。") | rich_text }}</p>
      </div>
      <dl>
        <div>
          <dt>主线闭环</dt>
          <dd>{{ "是" if lecture.completeness.mainline_closed else "待补强" }}</dd>
        </div>
        <div>
          <dt>无需看视频理解</dt>
          <dd>{{ "是" if lecture.completeness.reader_can_understand_without_video else "待补强" }}</dd>
        </div>
        <div>
          <dt>图文覆盖</dt>
          <dd>{{ (lecture.completeness.visual_coverage or "未说明") | rich_text }}</dd>
        </div>
        <div>
          <dt>知识沉淀</dt>
          <dd>{{ "可复用" if lecture.completeness.topic_reusability else "有限" }}</dd>
        </div>
      </dl>
      {% set missing = lecture.completeness.missing_prerequisites + lecture.completeness.missing_steps + lecture.completeness.missing_examples + lecture.completeness.missing_boundaries %}
      {% if missing %}
      <div class="missing-list">
        <strong>仍需注意：</strong>
        <ul>{% for item in missing %}<li>{{ item | rich_text }}</li>{% endfor %}</ul>
      </div>
      {% endif %}
    </section>
    {% endif %}

    {% if lecture.render_plan.visual_evidence_section and global_visual_evidence and not note_projection.has_units %}
    <section class="global-visual-evidence">
      <h2>全局关键图解</h2>
      {% for fr in global_visual_evidence %}
      <figure class="frame evidence-card"
              {% if frame_id_map and fr.path in frame_id_map %}id="frame-{{ frame_id_map[fr.path] }}" data-ref-kind="frame" data-ref-id="{{ frame_id_map[fr.path] }}"{% endif %}>
        <img src="{{ frame_url(fr.path) }}" alt="frame at {{ fr.ts | fmt_ts }}" loading="lazy" />
        <figcaption>
          <a href="{{ bili_link(lecture.bv_id, fr.ts) }}" target="_blank" rel="noopener">⚓ {{ fr.ts | fmt_ts }}</a>
          {% if fr.visual_type %}<span class="visual-type">{{ fr.visual_type }}</span>{% endif %}
          {% if fr.caption %} · {{ fr.caption | rich_text }}{% endif %}
        </figcaption>
        {% if fr.selected_reason or fr.insight or fr.ocr_text %}
        <details class="evidence-details">
          <summary>展开图像说明</summary>
          {% if fr.selected_reason or fr.insight %}
          <p>{{ (fr.selected_reason or fr.insight) | rich_text }}</p>
          {% endif %}
          {% if fr.ocr_text %}
          <details class="frame-ocr">
            <summary>画面 OCR</summary>
            <pre>{{ fr.ocr_text }}</pre>
          </details>
          {% endif %}
        </details>
        {% endif %}
      </figure>
      {% endfor %}
    </section>
    {% endif %}

    {% if type_recap and not note_projection.has_units %}
    <section class="adaptive-section {{ type_recap.style }}">
      <h2>{{ type_recap.title }}</h2>
      <div class="unit-grid">
        {% for unit in type_recap.units %}
        <article class="unit-card">
          <span class="unit-type">{{ unit.type }}</span>
          <h3>{{ unit.title | rich_text }}</h3>
          {% if unit.explanation %}<p>{{ unit.explanation | rich_text }}</p>{% endif %}
          <a href="{{ bili_link(lecture.bv_id, unit.ts) }}" target="_blank" rel="noopener">⚓ {{ unit.ts | fmt_ts }}</a>
        </article>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    {% if not note_projection.has_units %}
    <section class="generation-info">
      <h2>生成信息</h2>
      <dl>
        <div>
          <dt>视频类型</dt>
          <dd>{{ lecture.profile.primary_type }}</dd>
        </div>
        <div>
          <dt>内容密度</dt>
          <dd>{{ lecture.profile.density }}</dd>
        </div>
        <div>
          <dt>生成模式</dt>
          <dd>{{ lecture.generation_mode }}</dd>
        </div>
      </dl>
    </section>
    {% endif %}
  </main>

  <footer class="footer">
    <span>由 LectureMind 自动生成 · {{ generated_at }}</span>
    <span>·</span>
    <a href="{{ bili_link(lecture.bv_id, 0) }}" target="_blank" rel="noopener">原视频 ↗</a>
  </footer>

  <!-- Copilot panel stub + loader.  The actual DOM is built lazily by
       copilot.js on DOMContentLoaded so this element can live anywhere
       in <body>; keeping it at the end avoids layout shift. -->
  <aside id="cp-panel"
         data-bv="{{ lecture.bv_id }}"
         data-title="{{ lecture.title | default('', true) }}"></aside>
  <script defer src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <script defer src="/static/copilot.js"></script>

  {% if katex_assets_available %}
  <script defer src="assets/katex/katex.min.js"></script>
  <script defer src="assets/katex/contrib/mhchem.min.js"></script>
  <script defer src="assets/katex/contrib/auto-render.min.js"></script>
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      var target = document.querySelector(".content");
      if (!target || !window.renderMathInElement) {
        return;
      }
      window.renderMathInElement(target, {
        delimiters: [
          {left: "$$", right: "$$", display: true},
          {left: "\\[", right: "\\]", display: true},
          {left: "\\(", right: "\\)", display: false},
          {left: "$", right: "$", display: false}
        ],
        throwOnError: false
      });
    });
  </script>
  {% endif %}

  {% if highlight_assets_available %}
  <script defer src="assets/highlight/highlight.min.js"></script>
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      if (window.hljs) { window.hljs.highlightAll(); }
    });
  </script>
  {% elif highlight_cdn_url %}
  <script defer src="{{ highlight_cdn_url }}" crossorigin="anonymous"></script>
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      if (window.hljs) { window.hljs.highlightAll(); }
    });
  </script>
  {% endif %}
</body>
</html>
